{
  "schemaVersion": 1,
  "id": "com.t4t5.spaces",
  "name": "Spaces",
  "version": "0.2.0",
  "author": "T4T5",
  "description": "Project-based layout for Omarchy",
  "kinds": [
    "overlay",
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "omarchy/Toggle.qml",
    "service": "omarchy/Service.qml",
    "barWidget": "omarchy/TabsWidget.qml"
  },
  "barWidget": {
    "displayName": "Space tabs",
    "description": "The active space's tabs, in place of the workspaces",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
